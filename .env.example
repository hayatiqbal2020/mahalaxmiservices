# Copy to .env and fill in.

# Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (the "content" value of the meta tag).
# Only to override the code already set in src/lib/site.ts.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase (needed for saving enquiries and for the admin panel).
# Dashboard -> Project Settings -> API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...) or the older "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key (sb_secret_... or the older service_role key).
# Only needed for "Change password" on the admin Users page. Keep it private:
# it has full access to the database. No NEXT_PUBLIC_ prefix, so it stays on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Email alert for each new website enquiry (optional; no email is sent until set).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
# Who gets the alert. Defaults to the business email in src/lib/site.ts.
ENQUIRY_ALERT_TO=
# Only for a provider other than Gmail (defaults: smtp.gmail.com, 465).
SMTP_HOST=
SMTP_PORT=
