# Copy to .env and fill in.

# Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (the "content" value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase (needed for saving enquiries and for the admin panel).
# Dashboard -> Project Settings -> API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...) or the older "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key (sb_secret_... or the older service_role key).
# Only needed for "Change password" on the admin Users page. Keep it private:
# it has full access to the database. No NEXT_PUBLIC_ prefix, so it stays on the server.
SUPABASE_SERVICE_ROLE_KEY=
